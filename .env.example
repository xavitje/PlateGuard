# Owner connection: runs migrations and seed.
DATABASE_URL=postgresql://plateguard:plateguard@localhost:5432/plateguard
# The API runs every tenant query as the restricted role plateguard_app (row-level security applies).
API_PORT=3000
JWT_SECRET=change-me
# Development sign-in until PIN login: the API accepts the x-plateguard-user header only in this mode.
AUTH_MODE=dev
# The user the web app signs in as in development (the seeded demo waiter).
VITE_DEV_USER=00000000-0000-4000-8000-000000000101
