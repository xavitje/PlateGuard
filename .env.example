# Owner connection: runs migrations and seed.
DATABASE_URL=postgresql://plateguard:plateguard@localhost:5432/plateguard
# Or the cloud database (Supabase, session pooler, port 5432). See "Hosting" in the README.
# DATABASE_URL=postgresql://plateguard_owner.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# The API runs every tenant query as the restricted role plateguard_app (row-level security applies).
API_PORT=3000
# Signs the shift session tokens from PIN login. At least 16 characters; use a long random value.
JWT_SECRET=change-me-to-a-long-random-value
# Encrypts the secrets of POS links (Square tokens, webhook keys) in the database. At least 32
# characters. Changing it makes stored secrets unreadable: connect the POS again afterwards.
INTEGRATION_SECRET_KEY=change-me-to-another-long-random-value-of-32-chars
# Optional, for development without Square: point the sandbox at a local stand-in.
# SQUARE_SANDBOX_URL=http://127.0.0.1:4010
# Optional, for scripts and local tools: accept a user id in the x-plateguard-user header. Never in production.
# AUTH_MODE=dev
# The location a new device signs in to, until it is opened once with ?location=<slug>.
VITE_LOCATION_SLUG=de-haven-demo
