{
  "name": "plateguard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "dev:web": "pnpm build:packages && pnpm --filter @plateguard/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @plateguard/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "i18n:check": "pnpm --filter @plateguard/i18n check",
    "db:migrate": "pnpm --filter @plateguard/db migrate:deploy",
    "db:seed": "pnpm --filter @plateguard/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "pnpm --filter @plateguard/db test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.0"
  }
}
