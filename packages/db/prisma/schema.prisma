// PlateGuard data model, phase 1 and 2 plus the integration core.
//
// Tenant isolation: every operational table carries organization_id or location_id.
// Row-level security (migration 0002) refuses rows outside the session's app.org_id and
// app.location_ids, even if application code has a bug. See packages/db/src/tenant.ts.
//
// Incidents arrive in phase 4 and are not in this schema yet.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x: the Vercel function runtime (see vercel.json).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CHEF
  COOK
  WAITER
  RUNNER
}

enum Severity {
  INTOLERANCE
  ALLERGY
  SEVERE
}

enum Outcome {
  CLEAR
  CLEAR_WITH_NOTE
  ADAPTABLE
  CAUTION
  UNKNOWN
  DO_NOT_SERVE
}

enum PlateStatus {
  ASSESSED
  IN_KITCHEN
  CHECKED
  PASS_CHECKED
  SERVED
  REJECTED
  /// Taken off the order before the kitchen started. The assessment stays, append-only.
  CANCELLED
}

enum ServicePointKind {
  TABLE
  ROOM
  BAR_SEAT
}

enum TableShape {
  ROUND
  SQUARE
  RECT
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LocationType {
  RESTAURANT
  ROOM_SERVICE
  BAR
}

enum ServiceLevel {
  BASIC
  STANDARD
  FULL
}

enum DishKind {
  MENU
  DAILY_SPECIAL
  AMUSE
  BREAD
}

enum ModificationAction {
  OMIT
  SUBSTITUTE
}

enum CheckKind {
  KITCHEN
  PASS
}

enum CheckMethod {
  SCAN
  TAP
  KDS
}

enum IntegrationKind {
  POS
  KDS
  PRINTER
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

enum PrintJobKind {
  TICKET
  REPRINT
  TEST
}

enum PrintJobStatus {
  PENDING
  SENT
  PRINTED
  FAILED
}

enum QueueStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  DEAD
}

// ─── Organization ──────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String
  createdAt DateTime @default(now()) @map("created_at")

  locations   Location[]
  roles       RoleAssignment[]
  allergens   Allergen[]
  ingredients Ingredient[]
  equipment   Equipment[]
  components  Component[]

  @@map("organization")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  /// Public guest menu URL.
  slug           String       @unique
  type           LocationType @default(RESTAURANT)
  level          ServiceLevel @default(BASIC)
  /// Optional runner scan at the pass. Off by default: the cook scan is the check.
  passCheck      Boolean      @default(false) @map("pass_check")
  drinksInScope  Boolean      @default(false) @map("drinks_in_scope")
  defaultLocale  String       @default("en") @map("default_locale")
  kitchenLocale  String       @default("en") @map("kitchen_locale")
  guestLocales   String[]     @default(["en", "nl"]) @map("guest_locales")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  roles         RoleAssignment[]
  pins          StaffPin[]
  floors        Floor[]
  servicePoints ServicePoint[]
  menus         Menu[]
  dishes        Dish[]
  visits        Visit[]

  @@index([organizationId])
  @@map("location")
}

/// One person, one account, even when working for several locations or organizations.
/// Not tenant scoped: identity is resolved before a tenant is known. Read only through RoleAssignment.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String? @unique
  name         String
  locale       String  @default("en")
  passwordHash String? @map("password_hash")

  roles RoleAssignment[]
  pins  StaffPin[]

  @@map("app_user")
}

/// locationId null = the role holds for every location of the organization, including future ones.
model RoleAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid
  role           Role

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])

  @@unique([userId, organizationId, locationId, role])
  @@index([organizationId, locationId])
  @@map("role_assignment")
}

/// A PIN per person, per location (shared tablets). scrypt hash (hashPin in src/pin.ts), locked after 5 failed tries.
model StaffPin {
  userId      String @map("user_id") @db.Uuid
  locationId  String @map("location_id") @db.Uuid
  pinHash     String @map("pin_hash")
  failedTries Int    @default(0) @map("failed_tries")

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([userId, locationId])
  @@map("staff_pin")
}

// ─── Recipes ───────────────────────────────────────────────────────────────

/// EU-14 and subtypes have organizationId null and are visible to everyone.
model Allergen {
  code           String  @id
  parentCode     String? @map("parent_code")
  organizationId String? @map("organization_id") @db.Uuid
  isEu14         Boolean @default(false) @map("is_eu14")

  parent       Allergen?             @relation("AllergenTree", fields: [parentCode], references: [code])
  children     Allergen[]            @relation("AllergenTree")
  organization Organization?         @relation(fields: [organizationId], references: [id])
  translations AllergenTranslation[]

  @@map("allergen")
}

model AllergenTranslation {
  allergenCode   String  @map("allergen_code")
  locale         String
  organizationId String? @map("organization_id") @db.Uuid
  name           String
  description    String?

  allergen Allergen @relation(fields: [allergenCode], references: [code])

  @@id([allergenCode, locale])
  @@map("allergen_translation")
}

/// Shared across the organization's locations (a chain manages the jus once).
/// A different brand or article number resets verification.
model Ingredient {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// Other names for the allergy search: "tomaat", "tomatoes", "cherry tomato".
  synonyms       String[]  @default([])
  supplier       String?
  brand          String?
  articleNumber  String?   @map("article_number")
  contains       String[]
  mayContain     String[]  @map("may_contain")
  verifiedById   String?   @map("verified_by_id") @db.Uuid
  verifiedAt     DateTime? @map("verified_at")
  verifiedSource String?   @map("verified_source")

  organization   Organization          @relation(fields: [organizationId], references: [id])
  components     ComponentIngredient[]
  guestAllergies GuestAllergy[]

  @@index([organizationId])
  @@map("ingredient")
}

/// Shared preparation equipment (fryer 1, grill). Its allergens become traces.
model Equipment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  allergens      String[]

  organization Organization         @relation(fields: [organizationId], references: [id])
  components   ComponentEquipment[]

  @@index([organizationId])
  @@map("equipment")
}

model Component {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  name              String
  omittable         Boolean @default(false)
  premixed          Boolean @default(false)
  suitableForSevere Boolean @default(false) @map("suitable_for_severe")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  ingredients   ComponentIngredient[]
  equipment     ComponentEquipment[]
  children      ComponentChild[]       @relation("parent")
  parents       ComponentChild[]       @relation("child")
  substitutions Substitution[]         @relation("original")
  substituteFor Substitution[]         @relation("replacement")
  dishes        DishComponent[]
  translations  ComponentTranslation[]

  @@index([organizationId])
  @@map("component")
}

model ComponentIngredient {
  componentId    String @map("component_id") @db.Uuid
  ingredientId   String @map("ingredient_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  component  Component  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([componentId, ingredientId])
  @@map("component_ingredient")
}

model ComponentEquipment {
  componentId    String @map("component_id") @db.Uuid
  equipmentId    String @map("equipment_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@id([componentId, equipmentId])
  @@map("component_equipment")
}

/// Nesting: jus contains stock.
model ComponentChild {
  parentId       String @map("parent_id") @db.Uuid
  childId        String @map("child_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  parent Component @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Component @relation("child", fields: [childId], references: [id])

  @@id([parentId, childId])
  @@map("component_child")
}

/// The replacement goes through the engine itself, against every allergen of the guest.
model Substitution {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  componentId       String  @map("component_id") @db.Uuid
  replacementId     String  @map("replacement_id") @db.Uuid
  suitableForSevere Boolean @default(false) @map("suitable_for_severe")

  component   Component @relation("original", fields: [componentId], references: [id], onDelete: Cascade)
  replacement Component @relation("replacement", fields: [replacementId], references: [id])

  @@unique([componentId, replacementId])
  @@map("substitution")
}

model ComponentTranslation {
  componentId    String  @map("component_id") @db.Uuid
  locale         String
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  description    String?

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([componentId, locale])
  @@map("component_translation")
}

/// Menus and daily specials belong to a location.
model Dish {
  id          String   @id @default(uuid()) @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  name        String
  description String?
  course      Int      @default(0)
  priceCents  Int?     @map("price_cents")
  kind        DishKind @default(MENU)

  location     Location          @relation(fields: [locationId], references: [id])
  components   DishComponent[]
  translations DishTranslation[]
  menuItems    MenuItem[]

  @@index([locationId])
  @@map("dish")
}

model DishComponent {
  dishId      String @map("dish_id") @db.Uuid
  componentId String @map("component_id") @db.Uuid
  locationId  String @map("location_id") @db.Uuid
  sortOrder   Int    @default(0) @map("sort_order")

  dish      Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id])

  @@id([dishId, componentId])
  @@map("dish_component")
}

model DishTranslation {
  dishId      String  @map("dish_id") @db.Uuid
  locale      String
  locationId  String  @map("location_id") @db.Uuid
  name        String
  description String?

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([dishId, locale])
  @@map("dish_translation")
}

model Menu {
  id         String @id @default(uuid()) @db.Uuid
  locationId String @map("location_id") @db.Uuid
  name       String

  location Location      @relation(fields: [locationId], references: [id])
  versions MenuVersion[]
  items    MenuItem[]

  @@index([locationId])
  @@map("menu")
}

/// The draft: which dishes are on the menu, in which order. Service sees them only after publishing.
model MenuItem {
  menuId     String @map("menu_id") @db.Uuid
  dishId     String @map("dish_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([menuId, dishId])
  @@map("menu_item")
}

/// Publishing freezes a snapshot of every recipe on the menu; assessments point at it.
model MenuVersion {
  id          String        @id @default(uuid()) @db.Uuid
  menuId      String        @map("menu_id") @db.Uuid
  locationId  String        @map("location_id") @db.Uuid
  version     Int
  status      VersionStatus @default(DRAFT)
  snapshot    Json?
  pdfUrl      String?       @map("pdf_url")
  publishedAt DateTime?     @map("published_at")
  publishedBy String?       @map("published_by") @db.Uuid

  menu Menu @relation(fields: [menuId], references: [id])

  @@unique([menuId, version])
  @@map("menu_version")
}

// ─── Floor plan ────────────────────────────────────────────────────────────

/// A floor or zone: ground floor, terrace, first floor, bar.
model Floor {
  id            String        @id @default(uuid()) @db.Uuid
  locationId    String        @map("location_id") @db.Uuid
  name          String
  sortOrder     Int           @map("sort_order")
  hidden        Boolean       @default(false)
  versionStatus VersionStatus @default(DRAFT) @map("version_status")

  location Location       @relation(fields: [locationId], references: [id])
  points   ServicePoint[]
  elements FloorElement[]

  @@index([locationId])
  @@map("floor")
}

/// Positions are percentages of the canvas so the plan fits any screen.
model ServicePoint {
  id          String           @id @default(uuid()) @db.Uuid
  locationId  String           @map("location_id") @db.Uuid
  /// null = a room or seat without a drawing.
  floorId     String?          @map("floor_id") @db.Uuid
  kind        ServicePointKind @default(TABLE)
  label       String
  seats       Int
  shape       TableShape       @default(SQUARE)
  x           Float            @default(0)
  y           Float            @default(0)
  /// Size on the drawing, in percent of its width. null = sized from the seats and shape.
  w           Float?
  h           Float?
  /// Degrees clockwise.
  rotation    Float            @default(0)
  /// Table number in the POS.
  externalRef String?          @map("external_ref")
  qrToken     String           @unique @map("qr_token")
  active      Boolean          @default(true)

  location Location @relation(fields: [locationId], references: [id])
  floor    Floor?   @relation(fields: [floorId], references: [id])
  visits   Visit[]

  @@index([locationId])
  @@map("service_point")
}

model FloorElement {
  id         String  @id @default(uuid()) @db.Uuid
  floorId    String  @map("floor_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  /// BAR, WALL, DOOR, KITCHEN_PASS, LABEL. Orientation only.
  kind       String
  text       String?
  x          Float
  y          Float
  w          Float
  h          Float
  rotation   Float   @default(0)

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@map("floor_element")
}

// ─── Service ───────────────────────────────────────────────────────────────

model Visit {
  id              String    @id @default(uuid()) @db.Uuid
  locationId      String    @map("location_id") @db.Uuid
  servicePointId  String    @map("service_point_id") @db.Uuid
  /// Tables joined for this visit only; the floor plan stays as it is.
  joinedPointIds  String[]  @map("joined_point_ids") @db.Uuid
  openedById      String    @map("opened_by_id") @db.Uuid
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  /// Set when an incident is attached: guest data is then kept past the 24 hour anonymization.
  anonymizeFrozen Boolean   @default(false) @map("anonymize_frozen")

  location     Location     @relation(fields: [locationId], references: [id])
  servicePoint ServicePoint @relation(fields: [servicePointId], references: [id])
  guests       Guest[]
  plates       PlateOrder[]

  @@index([locationId, openedAt])
  @@map("visit")
}

/// Table and seat, never a name.
model Guest {
  id         String  @id @default(uuid()) @db.Uuid
  visitId    String  @map("visit_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  seat       Int
  /// "No allergy" is an answer too, logged as proof the question was asked.
  noAllergy  Boolean @default(false) @map("no_allergy")

  visit     Visit          @relation(fields: [visitId], references: [id])
  allergies GuestAllergy[]
  plates    PlateOrder[]

  @@unique([visitId, seat])
  @@map("guest")
}

/// One row per allergy, each with its own severity. Exactly one of these is set (check constraint
/// in the init migration):
/// - allergenCode: a known allergen,
/// - ingredientId: an ingredient from the organization's list, picked from the search under
///   "Other allergy"; the engine matches it against the recipes,
/// - customLabel: free text when nothing in the list fits; always UNKNOWN, checked by hand.
model GuestAllergy {
  id           String    @id @default(uuid()) @db.Uuid
  guestId      String    @map("guest_id") @db.Uuid
  locationId   String    @map("location_id") @db.Uuid
  allergenCode String?   @map("allergen_code")
  ingredientId String?   @map("ingredient_id") @db.Uuid
  customLabel  String?   @map("custom_label")
  /// Lower case, no accents (normalizeLabel in @plateguard/domain), so "Tomaat" and "tomaat" are one row.
  customKey    String?   @map("custom_key")
  severity     Severity  @default(SEVERE)
  recordedById String    @map("recorded_by_id") @db.Uuid
  changedById  String?   @map("changed_by_id") @db.Uuid
  changedAt    DateTime? @map("changed_at")

  guest      Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@unique([guestId, allergenCode])
  @@unique([guestId, ingredientId])
  @@unique([guestId, customKey])
  @@map("guest_allergy")
}

/// Only flagged plates have a status in PlateGuard; normal plates stay in the POS.
model PlateOrder {
  id            String      @id @default(uuid()) @db.Uuid
  locationId    String      @map("location_id") @db.Uuid
  visitId       String      @map("visit_id") @db.Uuid
  guestId       String      @map("guest_id") @db.Uuid
  dishId        String?     @map("dish_id") @db.Uuid
  menuVersionId String?     @map("menu_version_id") @db.Uuid
  course        Int
  status        PlateStatus
  remakeOfId    String?     @map("remake_of_id") @db.Uuid
  qrToken       String      @unique @map("qr_token")
  /// Why the kitchen sent it back to the waiter. Set with status REJECTED.
  rejectReason  String?     @map("reject_reason")
  rejectedAt    DateTime?   @map("rejected_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  visit         Visit               @relation(fields: [visitId], references: [id])
  guest         Guest               @relation(fields: [guestId], references: [id])
  remakeOf      PlateOrder?         @relation("Remake", fields: [remakeOfId], references: [id])
  remakes       PlateOrder[]        @relation("Remake")
  assessment    Assessment?
  checks        PlateCheck[]
  modifications PlateModification[]
  overrides     Override[]
  externalRefs  ExternalRef[]
  printJobs     PrintJob[]
  incidents     Incident[]

  @@index([locationId, status])
  @@map("plate_order")
}

/// Immutable: a trigger blocks UPDATE and DELETE.
model Assessment {
  id            String   @id @default(uuid()) @db.Uuid
  plateId       String   @unique @map("plate_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  outcome       Outcome
  /// Language-neutral reason codes from the engine.
  reasons       Json
  /// The full engine input, so the decision can be replayed.
  input         Json
  engineVersion String   @map("engine_version")
  menuVersionId String?  @map("menu_version_id") @db.Uuid
  inputHash     String   @map("input_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  plate PlateOrder @relation(fields: [plateId], references: [id])

  @@map("assessment")
}

/// A line on the allergy ticket. Mandatory; the waiter cannot remove it.
model PlateModification {
  id              String             @id @default(uuid()) @db.Uuid
  plateId         String             @map("plate_id") @db.Uuid
  locationId      String             @map("location_id") @db.Uuid
  componentId     String             @map("component_id") @db.Uuid
  action          ModificationAction
  substituteId    String?            @map("substitute_id") @db.Uuid
  reasonAllergens String[]           @map("reason_allergens")

  plate PlateOrder @relation(fields: [plateId], references: [id])

  @@map("plate_modification")
}

model PlateCheck {
  id         String      @id @default(uuid()) @db.Uuid
  plateId    String      @map("plate_id") @db.Uuid
  locationId String      @map("location_id") @db.Uuid
  kind       CheckKind
  byUserId   String      @map("by_user_id") @db.Uuid
  method     CheckMethod
  at         DateTime    @default(now())

  plate PlateOrder @relation(fields: [plateId], references: [id])

  @@map("plate_check")
}

/// Only for intolerance, by a manager, with the guest's consent and a reason.
model Override {
  id           String   @id @default(uuid()) @db.Uuid
  plateId      String   @map("plate_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  managerId    String   @map("manager_id") @db.Uuid
  reason       String
  guestConsent Boolean  @map("guest_consent")
  at           DateTime @default(now())

  plate PlateOrder @relation(fields: [plateId], references: [id])

  @@map("override")
}

/// Append only: a trigger blocks UPDATE and DELETE.
model AuditEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  type           String
  entity         String
  entityId       String   @map("entity_id")
  payload        Json
  at             DateTime @default(now())

  @@index([locationId, at])
  @@index([organizationId, at])
  @@map("audit_event")
}

// ─── Incidents ─────────────────────────────────────────────────────────────

enum IncidentKind {
  /// The guest reacted.
  REACTION
  /// Caught before the guest ate: the wrong plate, a missed check.
  NEAR_MISS
  /// Something else that went wrong around allergies.
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  CLOSED
}

/// Reported from a table or a plate. What was known at that moment is frozen in snapshot, and the
/// visit's guest data is kept past anonymization, so the follow-up works from the facts.
model Incident {
  id           String           @id @default(uuid()) @db.Uuid
  locationId   String           @map("location_id") @db.Uuid
  visitId      String?          @map("visit_id") @db.Uuid
  plateId      String?          @map("plate_id") @db.Uuid
  tableLabel   String           @map("table_label")
  seat         Int?
  kind         IncidentKind
  severity     IncidentSeverity
  description  String
  reportedById String           @map("reported_by_id") @db.Uuid
  reportedAt   DateTime         @default(now()) @map("reported_at")
  /// Plate, assessment input and outcome, checks, timeline with staff, the seat's allergies.
  snapshot     Json
  status       IncidentStatus   @default(OPEN)
  cause        String?
  measure      String?
  closedById   String?          @map("closed_by_id") @db.Uuid
  closedAt     DateTime?        @map("closed_at")

  plate PlateOrder? @relation(fields: [plateId], references: [id])

  @@index([locationId, reportedAt])
  @@map("incident")
}

// ─── Integrations ──────────────────────────────────────────────────────────

/// One POS, KDS or printer connection for a location. Secrets are encrypted at rest.
model IntegrationConnection {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  locationId       String           @map("location_id") @db.Uuid
  provider         String
  /// Shown in admin, for example "Kitchen" or "Grill".
  name             String?
  kind             IntegrationKind
  status           ConnectionStatus @default(PENDING)
  capabilities     String[]
  encryptedSecrets Bytes?           @map("encrypted_secrets")
  config           Json             @default("{}")
  lastHealthAt     DateTime?        @map("last_health_at")
  lastHealthOk     Boolean?         @map("last_health_ok")
  createdAt        DateTime         @default(now()) @map("created_at")

  mappings      PosItemMapping[]
  externalRefs  ExternalRef[]
  inboundEvents InboundEvent[]
  printJobs     PrintJob[]

  @@index([locationId])
  @@map("integration_connection")
}

/// An allergy ticket for a kitchen printer that fetches its own jobs (Star CloudPRNT). It holds
/// the plate, not the text: the ticket is drawn when the printer fetches it.
model PrintJob {
  id           String         @id @default(uuid()) @db.Uuid
  locationId   String         @map("location_id") @db.Uuid
  connectionId String         @map("connection_id") @db.Uuid
  plateId      String?        @map("plate_id") @db.Uuid
  kind         PrintJobKind
  status       PrintJobStatus @default(PENDING)
  attempts     Int            @default(0)
  lastError    String?        @map("last_error")
  createdAt    DateTime       @default(now()) @map("created_at")
  sentAt       DateTime?      @map("sent_at")
  printedAt    DateTime?      @map("printed_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id])
  plate      PlateOrder?           @relation(fields: [plateId], references: [id], onDelete: SetNull)

  @@index([connectionId, status, createdAt])
  @@map("print_job")
}

model PosItemMapping {
  id             String    @id @default(uuid()) @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  externalItemId String    @map("external_item_id")
  dishId         String?   @map("dish_id") @db.Uuid
  confirmedById  String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime? @map("confirmed_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, externalItemId])
  @@map("pos_item_mapping")
}

/// Recognize the same plate across systems: POS order line, KDS ticket.
model ExternalRef {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid
  externalType String @map("external_type")
  externalId   String @map("external_id")
  plateId      String @map("plate_id") @db.Uuid

  connection IntegrationConnection @relation(fields: [connectionId], references: [id])
  plate      PlateOrder            @relation(fields: [plateId], references: [id])

  @@unique([connectionId, externalType, externalId])
  @@map("external_ref")
}

/// Raw incoming webhook or polled message, stored before processing.
model InboundEvent {
  id             String      @id @default(uuid()) @db.Uuid
  connectionId   String      @map("connection_id") @db.Uuid
  locationId     String      @map("location_id") @db.Uuid
  idempotencyKey String      @map("idempotency_key")
  payload        Json
  status         QueueStatus @default(PENDING)
  attempts       Int         @default(0)
  lastError      String?     @map("last_error")
  /// What handling the message did, for admin: plates added, lines skipped and why.
  result         Json?
  receivedAt     DateTime    @default(now()) @map("received_at")
  processedAt    DateTime?   @map("processed_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, idempotencyKey])
  @@index([status, receivedAt])
  @@map("inbound_event")
}

/// Written in the same transaction as the change it describes; a dispatcher delivers it.
model OutboxEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  locationId     String?     @map("location_id") @db.Uuid
  /// For example plate.checked.v1.
  type           String
  payload        Json
  status         QueueStatus @default(PENDING)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now()) @map("next_attempt_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  processedAt    DateTime?   @map("processed_at")

  deliveries WebhookDelivery[]

  @@index([status, nextAttemptAt])
  @@map("outbox_event")
}

model WebhookSubscription {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  url             String
  events          String[]
  encryptedSecret Bytes    @map("encrypted_secret")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_subscription")
}

model WebhookDelivery {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  subscriptionId String      @map("subscription_id") @db.Uuid
  outboxEventId  String      @map("outbox_event_id") @db.Uuid
  status         QueueStatus @default(PENDING)
  attempts       Int         @default(0)
  lastStatusCode Int?        @map("last_status_code")
  lastResponse   String?     @map("last_response")
  nextAttemptAt  DateTime    @default(now()) @map("next_attempt_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])
  outboxEvent  OutboxEvent         @relation(fields: [outboxEventId], references: [id])

  @@unique([subscriptionId, outboxEventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_delivery")
}
